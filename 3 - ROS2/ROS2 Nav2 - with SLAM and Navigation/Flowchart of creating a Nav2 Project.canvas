{
	"nodes":[
		{"id":"34469e8493a4903f","type":"text","text":"Draw walls, windows and door","x":-60,"y":20,"width":250,"height":60,"color":"5"},
		{"id":"9c9c6b64744ca76c","type":"text","text":"Import -> select image -> Set Scale","x":-60,"y":-380,"width":250,"height":60,"color":"5"},
		{"id":"fb3415bf18bc594c","type":"text","text":"gazebo -> Edit -> Building Editor","x":-60,"y":-500,"width":250,"height":60,"color":"5"},
		{"id":"9ee3cb967ea6c202","type":"text","text":"Create a custom room","x":-220,"y":-180,"width":250,"height":60,"color":"5"},
		{"id":"ff1ec23d632bac49","type":"text","text":"Create a custom room from image","x":100,"y":-180,"width":250,"height":60,"color":"5"},
		{"id":"85de494a758c4db2","type":"text","text":"File -> Save As -> \"Name\"","x":-60,"y":120,"width":250,"height":60,"color":"5"},
		{"id":"f887e19fc3acd7b5","type":"text","text":"Open Gazebo -> Insert -> building_editor_models -> \"your room\"","x":-60,"y":217,"width":250,"height":83,"color":"5"},
		{"id":"65032d792f406e9c","type":"text","text":"Save As -> \"world_name\"","x":-59,"y":340,"width":250,"height":60,"color":"5"},
		{"id":"3940dd00dd5c3e83","type":"text","text":"copy/ move that world to the worlds dir of turtlebot3_gazebo package","x":-59,"y":434,"width":250,"height":106,"color":"5"},
		{"id":"ccb17805f2789920","type":"text","text":"Create a launch file pointing towards the new world","x":-59,"y":580,"width":250,"height":98,"color":"5"},
		{"id":"6bf8f4744b69ce9c","type":"text","text":"Run `ros2 launch turtlebot3_gazebo new_world.launch.py`","x":-359,"y":860,"width":250,"height":95,"color":"5"},
		{"id":"735c5f14e5fbc705","type":"text","text":"Run `ros2 launch turtlebot3_cartographer cartographer.launch.py`","x":-59,"y":860,"width":250,"height":88,"color":"5"},
		{"id":"7764501d5ac07086","type":"text","text":"Run `ros2 run turtlebot3_teleop teleop_keyboard`","x":241,"y":860,"width":250,"height":88,"color":"5"},
		{"id":"6145f1cee580116d","type":"text","text":"Map the whole world using teleop by moving the turtlrbot","x":-59,"y":980,"width":250,"height":84,"color":"5"},
		{"id":"1c64db08b45abbec","type":"text","text":"Run `ros2 run nav2_map_server map_saver_cli -f maze` to save the map.\n`-f maze` is used to give a filename","x":-123,"y":1100,"width":379,"height":100,"color":"5"},
		{"id":"3dd7d1fbed4e0748","type":"text","text":"will create a `.pgm` and `.yaml` into a maps directory.(need to be in maps directory)","x":351,"y":1100,"width":280,"height":100,"color":"5"},
		{"id":"5b1fd6732436fbe3","type":"text","text":"Run `ros2 launch turtlebot3_gazebo new_world.launch.py`","x":-248,"y":1360,"width":250,"height":90,"color":"5"},
		{"id":"042ea1055fea5ae3","type":"text","text":"Run `ros2 launch turtlebot3_navigation2 navigation2.launch.py use_sim_time:=True map:=maps/new_world.yaml` ","x":149,"y":1360,"width":403,"height":90,"color":"5"},
		{"id":"b0288372c65fc525","type":"text","text":"Estimate the Pose of the turtlebot and give Goal Pose and Enjoy!!","x":-58,"y":1620,"width":250,"height":104,"color":"5"}
	],
