{
	"nodes":[
		{"id":"a8a84c2fb9186b84","type":"text","text":"Install SLAM Toolbox\n`sudo apt install ros-humble-slam-toolbox`","x":-245,"y":-900,"width":250,"height":96},
		{"id":"473d73ec0a5d443e","x":115,"y":-900,"width":250,"height":96,"type":"text","text":"Requirement ->\nLaserScan should be published on the /scan topic"},
		{"id":"f3c24e9054ee4c15","x":-60,"y":-640,"width":250,"height":60,"type":"text","text":"This is to load a new map"},
		{"id":"4c9f006052752093","x":-220,"y":-340,"width":250,"height":120,"type":"text","text":"Terminal 2: \n`ros2 launch nav2_bringup navigation.launch.py use_sim_time:=True`"},
		{"id":"d9d7744729602525","x":100,"y":-340,"width":250,"height":120,"type":"text","text":"Terminal 3: \n`ros2 launch slam_toolbox online_async_launch.py use_sim_time:=True`\n"},
		{"id":"1f97b727b7527a16","x":-540,"y":-330,"width":250,"height":100,"type":"text","text":"Terminal 1:\n\t`ros2 launch agv_description agv_gazebo.launch.xml `"},
		{"id":"ce5088544f229943","x":400,"y":-310,"width":250,"height":60,"type":"text","text":"Terminal 4: `rviz2` or `ros2 run rviz2 rviz2`"},
		{"id":"d40c84cfb3f2ebbb","x":-402,"y":296,"width":250,"height":84,"type":"text","text":"Start the robot stack\n`ros2 launch agv_description agv_gazebo.launch.xml`"},
		{"id":"8e004911ca9b8d00","x":-20,"y":1100,"width":250,"height":60,"type":"text","text":""},
		{"id":"e66c74299eeb9baa","x":265,"y":308,"width":250,"height":60,"type":"text","text":"`ros2 run rviz2 rviz2`"},
		{"id":"03e1294861bbb181","x":-74,"y":-60,"width":301,"height":85,"type":"text","text":"Use `ros2 run turtlebot3_teleop teleop_kkeyboard_twist` to move the robot and load the map"},
		{"id":"ca135d1d317c70ec","x":-123,"y":100,"width":400,"height":55,"type":"text","text":"Save the map using:\n`ros2 run nav2_map_server map_saver_cli -f filename`"},
		{"id":"f6385fabf778cf98","x":-60,"y":276,"width":274,"height":124,"type":"text","text":"`ros2 launch nav2_bringup bringup_launch.py use_sim_time:=True map:=map_location.yaml`"}
	],
